# Normalize line endings
* text=auto eol=lf

# Explicitly declare text files
*.ts text
*.tsx text
*.js text
*.mjs text
*.jsx text
*.json text
*.md text
*.yml text
*.yaml text
*.css text
*.html text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
